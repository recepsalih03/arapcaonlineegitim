# ---------------------------------------------------------------------------
# Online Arapça Özel Ders Platformu — ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. ".env" git'e girmez.
# ---------------------------------------------------------------------------

# --- Veritabanı (Neon / PostgreSQL) ---------------------------------------
# Neon panelinde "Connection string" > "Pooled connection" değerini kullanın.
# Neon'un verdiği adreste sslmode=require yazar; onu sslmode=verify-full yapın:
# hem sertifika doğrulaması tam olur hem de pg sürücüsünün uyarısı susar.
DATABASE_URL="postgresql://kullanici:sifre@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
# Migration'lar için havuzsuz (direct) bağlantı. Neon'da "Connection pooling" kapalı hali.
DIRECT_DATABASE_URL="postgresql://kullanici:sifre@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""
# Vercel arkasında proxy olduğu için gerekli.
AUTH_TRUST_HOST="true"
# AUTH_URL bilerek YOK: AUTH_TRUST_HOST=true iken Auth.js adresi isteğin
# kendisinden okur. Elle sabitlerseniz önizleme dağıtımları ve farklı portlar
# yanlış adrese yönlenir.

# --- Cloudflare R2 ---------------------------------------------------------
# R2 > Manage API Tokens > Create API Token (Object Read & Write)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="arapca-videolar"
# Genelde: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# --- Uygulama ayarları -----------------------------------------------------
# Bir hesabın giriş yapabileceği en fazla fiziksel cihaz sayısı.
MAX_DEVICES_PER_USER="4"
# İlk admin hesabı (yalnızca "npm run db:seed" tarafından okunur).
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="degistir-beni"
